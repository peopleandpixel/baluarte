database:
  path: 'baluarte.sqlite'

cache:
  backend: 'filesystem' # 'filesystem' or 'redis'
  namespace: 'baluarte'
  default_lifetime: 0
  redis:
    dsn: 'redis://localhost:6379'

logging:
  max_files: 7

api:
  jwt_secret: 'a-very-long-and-secure-secret-key-that-is-at-least-thirty-two-characters'
  abuseipdb:
    key: '' # Enter your AbuseIPDB API key here
  dnsbl:
    - 'zen.spamhaus.org'
    - 'bl.spamcop.net'
    - 'dnsbl.sorbs.net'

geoip:
  database_path: 'data/GeoLite2-City.mmdb'

firewall:
  enabled: false
  driver: 'ufw' # Can be 'ufw', 'iptables', or 'nftables' (default: ufw)

whitelist:
  ips:
    - '127.0.0.1'
  countries:
    - 'BE' # Belgium
    - 'US' # United States

notifications:
  webhook:
    url: '' # Enter your webhook URL here
  mqtt:
    enabled: false
    host: 'localhost'
    port: 1883
    client_id: 'baluarte'
    username: ''
    password: ''
    topic_prefix: 'baluarte'

patterns:
  ssh_failed_login:
    regex: '/Failed password for (?:invalid user )?\S+ from (\d+\.\d+\.\d+\.\d+) port \d+ ssh2/'
    reason: 'SSH failed login attempt'
    enabled: true
  ssh_invalid_user:
    regex: '/Invalid user \S+ from (\d+\.\d+\.\d+\.\d+) port \d+/'
    reason: 'SSH invalid user attempt'
    enabled: true
  nginx_404_probing:
    regex: '/(\d+\.\d+\.\d+\.\d+) .* "GET .*(?:\.php|\.env|\.git|\.config|wp-admin|admin).* HTTP\/.*" 404/i'
    reason: 'Vulnerability probing (404)'
    enabled: true
  apache_access_sqli:
    regex: '/(\d+\.\d+\.\d+\.\d+).*"(?:GET|POST|HEAD).* (?:UNION|SELECT|INSERT|UPDATE|DELETE|DROP|--|#)/i'
    reason: 'SQL injection attempt'
    enabled: true
  apache_access_path_traversal:
    regex: '/^(\d+\.\d+\.\d+\.\d+).*"(?:GET|POST|HEAD).*\.\.\//i'
    reason: 'Path traversal attempt'
    enabled: true
  auth_log_brute_force:
    regex: '/(\d+\.\d+\.\d+\.\d+) .*: Failed password for/i'
    reason: 'Brute force attempt'
    enabled: true
  json_example:
    format: 'json'
    field: 'log'
    regex: '/Failed login from (\d+\.\d+\.\d+\.\d+)/'
    reason: 'JSON log failure'
    enabled: false
  imap_failed_login:
    regex: '/imap-login: Disconnected \(auth failed, \d+ attempts in \d+ secs\): user=<[^>]*>, method=\S+, rip=(\d+\.\d+\.\d+\.\d+), lip=\S+(?:, TLS(?:=\S+)?, session=<\S+>)?/'
    reason: 'IMAP failed login'
    enabled: true
  dovecot_auth_fail:
    regex: '/auth-worker\(.*\): (?:pam|passwd-file)\(.*,(\d+\.\d+\.\d+\.\d+)\): Password mismatch/i'
    reason: 'Dovecot authentication failure'
    enabled: true
  smtp_failed_login:
    regex: '/lost connection after AUTH from \S+\[(\d+\.\d+\.\d+\.\d+)\]/'
    reason: 'SMTP failed login'
    enabled: true
  proftpd_failed_login:
    regex: '/proftpd\[\d+\] \S+ \((\d+\.\d+\.\d+\.\d+)\[\d+\.\d+\.\d+\.\d+\]\): USER \S+: no such user found from \d+\.\d+\.\d+\.\d+ to \d+\.\d+\.\d+\.\d+:\d+/i'
    reason: 'ProFTPD failed login'
    enabled: true
  sudo_invalid:
    regex: '/sudo:.*TTY=\S+ ; PWD=\S+ ; USER=\S+ ; COMMAND=\S+ ; [^;]*user NOT in sudoers/i'
    reason: 'Invalid sudo attempt'
    enabled: true
  sudo_auth_fail:
    regex: '/sudo:.*auth failure;.*rhost=(\d+\.\d+\.\d+\.\d+)/'
    reason: 'Sudo authentication failure'
    enabled: true
  wordpress_xmlrpc:
    regex: '/(\d+\.\d+\.\d+\.\d+) .* "POST \/xmlrpc\.php HTTP\/.*" 200/i'
    reason: 'WordPress XML-RPC abuse'
    enabled: true
  wordpress_wp_login:
    regex: '/(\d+\.\d+\.\d+\.\d+) .* "POST \/wp-login\.php HTTP\/.*" 200/i'
    reason: 'WordPress brute force attempt'
    enabled: true
  php_unit_rce:
    regex: '/(\d+\.\d+\.\d+\.\d+) .* "GET \/vendor\/phpunit\/phpunit\/src\/Util\/PHP\/eval-stdin\.php HTTP\/.*" 200/i'
    reason: 'PHPUnit RCE exploit attempt'
    enabled: true
  generic_web_shell:
    regex: '/(\d+\.\d+\.\d+\.\d+) .* "GET .*(?:shell|cmd|sh|bash|webshell)\.php.* HTTP\/.*" 200/i'
    reason: 'Web shell probe'
    enabled: true

gui:
  password_hash: '' # Leave empty to disable password protection
  two_factor_secret: '' # Leave empty to disable 2FA
  two_factor_enabled: false

honeypot:
  enabled: false
  bind: '0.0.0.0'
  http_port: 8081
  threshold: 3
  window_minutes: 5
  ban_minutes: 1440
  log_thinning_ttl: 15
