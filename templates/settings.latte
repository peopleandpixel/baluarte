{layout 'layout.latte'}

{block title}{_'settings.title'}{/block}

{block content}
{if isset($_GET['saved'])}
<div class="alert alert-success shadow-lg mb-6">
    <div>
        <i class="bi bi-check-circle-fill"></i>
        <span>{_'settings.saved'}</span>
    </div>
</div>
{/if}

<form method="POST">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="space-y-6">
            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.general.title'}</h2>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.general.db_path'}</span></label>
                        <input type="text" name="db_path" class="input input-bordered w-full" value="{$config['database']['path'] ?? 'baluarte.sqlite'}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.general.geoip_path'}</span></label>
                        <input type="text" name="geoip_path" class="input input-bordered w-full" value="{$config['geoip']['database_path'] ?? ''}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.general.abuseipdb_key'}</span></label>
                        <input type="password" name="abuseipdb_key" class="input input-bordered w-full" value="{$config['api']['abuseipdb']['key'] ?? ''}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.general.jwt_secret'}</span></label>
                        <input type="text" name="jwt_secret" class="input input-bordered w-full" value="{$config['api']['jwt_secret'] ?? ''}">
                        <label class="label"><span class="label-text-alt opacity-70">{_'settings.general.jwt_help'}</span></label>
                    </div>
                </div>
            </div>

            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.firewall.title'}</h2>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-4">
                            <input type="checkbox" name="firewall_enabled" class="checkbox checkbox-primary" {if isset($config['firewall']['enabled']) && $config['firewall']['enabled']}checked{/if}>
                            <span class="label-text">{_'settings.firewall.enabled'}</span>
                        </label>
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.firewall.driver'}</span></label>
                        <select name="firewall_driver" class="select select-bordered w-full">
                            <option value="ufw" {if ($config['firewall']['driver'] ?? '') === 'ufw'}selected{/if}>UFW</option>
                            <option value="iptables" {if ($config['firewall']['driver'] ?? '') === 'iptables'}selected{/if}>iptables</option>
                            <option value="nftables" {if ($config['firewall']['driver'] ?? '') === 'nftables'}selected{/if}>nftables</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.logging.title'}</h2>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.logging.max_files'}</span></label>
                        <input type="number" name="logging_max_files" class="input input-bordered w-full" value="{$config['logging']['max_files'] ?? 7}">
                    </div>
                </div>
            </div>

            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.gui.title'}</h2>
                        <div class="form-control w-full">
                            <label class="label"><span class="label-text">{_'settings.gui.new_password'}</span></label>
                            <input type="password" name="new_password" class="input input-bordered w-full" placeholder="Leave empty to keep current">
                            <label class="label"><span class="label-text-alt opacity-70">{_'settings.gui.password_help'}</span></label>
                        </div>

                        <div class="form-control w-full">
                            <label class="label"><span class="label-text">{_'settings.gui.theme'}</span></label>
                            <select name="theme" class="select select-bordered w-full">
                                <option value="baluarte" {if ($config['gui']['theme'] ?? 'baluarte') === 'baluarte'}selected{/if}>{_'settings.gui.theme.dark'}</option>
                                <option value="baluarte_light" {if ($config['gui']['theme'] ?? '') === 'baluarte_light'}selected{/if}>{_'settings.gui.theme.light'}</option>
                            </select>
                        </div>

                        <div class="divider">{_'settings.gui.2fa'}</div>

                        <div class="form-control">
                            <label class="label cursor-pointer justify-start gap-4">
                                <input type="checkbox" name="two_factor_enabled" class="checkbox checkbox-primary" {if isset($config['gui']['two_factor_enabled']) && $config['gui']['two_factor_enabled']}checked{/if}>
                                <span class="label-text text-lg font-semibold">{_'settings.gui.2fa_enabled'}</span>
                            </label>
                        </div>

                        {if $twoFactorSecret}
                            <div class="mt-4 flex flex-col items-center p-4 bg-gray-100 rounded-lg">
                                <img src="{$qrCode}" alt="2FA QR Code" class="w-48 h-48">
                                <p class="text-black font-mono mt-2 text-sm">{$twoFactorSecret}</p>
                            </div>
                            <p class="text-xs opacity-70 mt-2">{_'settings.gui.2fa_help'}</p>
                        {/if}

                        <div class="mt-4">
                            <button type="submit" name="regenerate_2fa" class="btn btn-outline btn-sm btn-warning w-full" onclick="return confirm('{_'settings.gui.2fa_confirm'}')">
                                {if $twoFactorSecret}{_'settings.gui.2fa_regenerate'}{else}{_'settings.gui.2fa_setup'}{/if}
                            </button>
                        </div>

                        <div class="card-actions mt-6">
                            <button type="submit" name="action" value="update_gui_settings" class="btn btn-primary w-full">{_'settings.gui.save'}</button>
                        </div>
                    </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.notifications.webhook.title'}</h2>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.webhook.url'}</span></label>
                        <input type="text" name="webhook_url" class="input input-bordered w-full" value="{$config['notifications']['webhook']['url'] ?? ''}">
                    </div>
                </div>
            </div>

            <div class="card bg-base-200 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">{_'settings.notifications.mqtt.title'}</h2>
                    <div class="form-control">
                        <label class="label cursor-pointer justify-start gap-4">
                            <input type="checkbox" name="mqtt_enabled" class="checkbox checkbox-primary" {if isset($config['notifications']['mqtt']['enabled']) && $config['notifications']['mqtt']['enabled']}checked{/if}>
                            <span class="label-text">{_'settings.notifications.mqtt.enabled'}</span>
                        </label>
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.host'}</span></label>
                        <input type="text" name="mqtt_host" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['host'] ?? 'localhost'}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.port'}</span></label>
                        <input type="number" name="mqtt_port" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['port'] ?? 1883}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.client_id'}</span></label>
                        <input type="text" name="mqtt_client_id" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['client_id'] ?? 'baluarte'}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.username'}</span></label>
                        <input type="text" name="mqtt_username" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['username'] ?? ''}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.password'}</span></label>
                        <input type="password" name="mqtt_password" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['password'] ?? ''}">
                    </div>
                    <div class="form-control w-full">
                        <label class="label"><span class="label-text">{_'settings.notifications.mqtt.topic'}</span></label>
                        <input type="text" name="mqtt_topic_prefix" class="input input-bordered w-full" value="{$config['notifications']['mqtt']['topic_prefix'] ?? 'baluarte'}">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-base-200 shadow-xl mt-6">
        <div class="card-body">
            <h2 class="card-title mb-4">{_'settings.patterns.title'}</h2>
            <div id="patterns-container" class="space-y-4">
                {foreach $config['patterns'] ?? [] as $patternId => $pattern}
                <div class="p-4 bg-base-300 rounded-lg">
                    <h3 class="font-bold mb-2 text-primary">{_'settings.patterns.pattern', $patternId}</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div class="form-control w-full">
                            <label class="label"><span class="label-text text-xs">{_'settings.patterns.regex'}</span></label>
                            <input type="text" name="patterns[{$patternId}][regex]" class="input input-bordered input-sm w-full font-mono" value="{$pattern['regex']}">
                        </div>
                        <div class="form-control w-full">
                            <label class="label"><span class="label-text text-xs">{_'settings.patterns.reason'}</span></label>
                            <input type="text" name="patterns[{$patternId}][reason]" class="input input-bordered input-sm w-full" value="{$pattern['reason'] ?? ''}">
                        </div>
                        <div class="form-control">
                            <label class="label cursor-pointer justify-start gap-4">
                                <span class="label-text text-xs">{_'settings.patterns.enabled'}</span>
                                <input type="checkbox" name="patterns[{$patternId}][enabled]" class="checkbox checkbox-xs" {if $pattern['enabled']}checked{/if}>
                            </label>
                        </div>
                        <div class="form-control w-full">
                            <label class="label"><span class="label-text text-xs">{_'settings.patterns.format'}</span></label>
                            <input type="text" name="patterns[{$patternId}][format]" class="input input-bordered input-sm w-full" value="{$pattern['format'] ?? ''}" placeholder="e.g. json">
                        </div>
                        <div class="form-control w-full">
                            <label class="label"><span class="label-text text-xs">{_'settings.patterns.field'}</span></label>
                            <input type="text" name="patterns[{$patternId}][field]" class="input input-bordered input-sm w-full" value="{$pattern['field'] ?? ''}" placeholder="e.g. log">
                        </div>
                    </div>
                </div>
                {/foreach}
            </div>

            <div class="divider">{_'settings.patterns.add_new'}</div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="form-control w-full">
                    <label class="label"><span class="label-text text-xs">{_'settings.patterns.new_id'}</span></label>
                    <input type="text" name="new_pattern_id" class="input input-bordered input-sm w-full">
                </div>
                <div class="form-control w-full">
                    <label class="label"><span class="label-text text-xs">{_'settings.patterns.regex'}</span></label>
                    <input type="text" name="new_pattern_regex" class="input input-bordered input-sm w-full font-mono">
                </div>
                <div class="form-control w-full">
                    <label class="label"><span class="label-text text-xs">{_'settings.patterns.reason'}</span></label>
                    <input type="text" name="new_pattern_reason" class="input input-bordered input-sm w-full">
                </div>
                <div class="form-control w-full">
                    <label class="label"><span class="label-text text-xs">{_'settings.patterns.format'}</span></label>
                    <input type="text" name="new_pattern_format" class="input input-bordered input-sm w-full" placeholder="e.g. json">
                </div>
                <div class="form-control w-full">
                    <label class="label"><span class="label-text text-xs">{_'settings.patterns.field'}</span></label>
                    <input type="text" name="new_pattern_field" class="input input-bordered input-sm w-full" placeholder="e.g. log">
                </div>
            </div>
        </div>
    </div>

            <div class="card-actions justify-end mt-8">
                <button type="submit" name="action" value="update_config" class="btn btn-primary">{_'settings.patterns.save'}</button>
            </div>
</form>
{/block}
