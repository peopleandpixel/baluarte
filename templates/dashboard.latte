{layout 'layout.latte'}

{block title}{_'dashboard.title'}{/block}

{block content}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stats shadow bg-primary text-primary-content">
        <div class="stat">
            <div class="stat-title text-primary-content opacity-70">{_'dashboard.stats.active_bans'}</div>
            <div class="stat-value">{$activeBansCount}</div>
            <div class="stat-figure text-primary-content">
                <i class="bi bi-shield-slash text-3xl"></i>
            </div>
        </div>
    </div>
    
    <div class="stats shadow bg-warning text-warning-content">
        <div class="stat">
            <div class="stat-title text-warning-content opacity-70">{_'dashboard.stats.threats_detected'}</div>
            <div class="stat-value">{$detectedIpsCount}</div>
            <div class="stat-figure text-warning-content">
                <i class="bi bi-exclamation-triangle text-3xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="card bg-base-200 shadow-xl mb-8">
    <div class="card-body">
        <h2 class="card-title mb-4">{_'dashboard.threat_distribution'}</h2>
        <div id="map" style="height: 400px; width: 100%; border-radius: 1rem;"></div>
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Threats over time chart -->
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4">Threats Over Time</h2>
            <div class="flex gap-2 mb-4">
                <button class="btn btn-xs btn-active chart-period-btn" data-period="hour">24h</button>
                <button class="btn btn-xs chart-period-btn" data-period="day">30d</button>
                <button class="btn btn-xs chart-period-btn" data-period="week">12w</button>
            </div>
            <canvas id="threatsTimeChart" height="200"></canvas>
        </div>
    </div>

    <!-- Top countries chart -->
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4">Top Attacking Countries</h2>
            <canvas id="topCountriesChart" height="200"></canvas>
        </div>
    </div>

    <!-- Attack types chart -->
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4">Attack Types Distribution</h2>
            <canvas id="attackTypesChart" height="200"></canvas>
        </div>
    </div>

    <!-- Ban timeline chart -->
    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            <h2 class="card-title mb-4">Ban Expirations (Next 24h)</h2>
            <canvas id="banTimelineChart" height="200"></canvas>
        </div>
    </div>
</div>

<script type="application/json" id="initial-threats">
    {$detectedIps|noescape}
</script>

<div class="card bg-base-200 shadow-xl">
    <div class="card-body">
        <div class="flex justify-between items-center mb-4">
            <h2 class="card-title">{_'dashboard.recent_threats'}</h2>
            <a href="/blocked-ips" target="_blank" class="btn btn-sm btn-outline">{_'dashboard.view_blocklist'}</a>
        </div>
        
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full" id="threats-table">
                <thead>
                    <tr>
                        <th style="display:none">ID</th>
                        <th>{_'dashboard.table.ip'}</th>
                        <th>{_'dashboard.table.country'}</th>
                        <th>{_'dashboard.table.reason'}</th>
                        <th>{_'dashboard.table.detected_at'}</th>
                        <th>{_'dashboard.table.actions'}</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $detectedIps as $threatItem}
                    <tr data-id="{$threatItem['id']}">
                        <td style="display:none">{$threatItem['id']}</td>
                        <td>
                            <a href="/?page=ip-details&ip={$threatItem['ip']}" class="hover:underline">
                                <span class="font-mono">{$threatItem['ip']}</span>
                            </a>
                        </td>
                        <td>
                            {if isset($threatItem['country']) && $threatItem['country'] !== 'Unknown'}
                                <span class="badge badge-ghost">{$threatItem['country']}</span>
                            {else}
                                <span class="opacity-50">{_'dashboard.unknown'}</span>
                            {/if}
                        </td>
                        <td>{$threatItem['reason']}</td>
                        <td><span class="text-xs">{$threatItem['detected_at']}</span></td>
                        <td>
                            <div class="flex gap-2">
                                <a href="/?page=ip-details&ip={$threatItem['ip']}" class="btn btn-xs btn-ghost">
                                    <i class="bi bi-info-circle"></i> {_'dashboard.actions.details'}
                                </a>
                                <form method="POST">
                                    <input type="hidden" name="action" value="add_ban">
                                    <input type="hidden" name="target" value="{$threatItem['ip']}">
                                    <input type="hidden" name="type" value="ip">
                                    <button type="submit" class="btn btn-xs btn-error">{_'dashboard.actions.ban_ip'}</button>
                                </form>
                                {if isset($threatItem['country']) && $threatItem['country'] !== 'Unknown'}
                                <form method="POST">
                                    <input type="hidden" name="action" value="add_ban">
                                    <input type="hidden" name="target_country" value="{$threatItem['country']}">
                                    <input type="hidden" name="type" value="country">
                                    <button type="submit" class="btn btn-xs btn-outline btn-error">{_'dashboard.actions.ban_country'}</button>
                                </form>
                                {/if}
                            </div>
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script n:syntax="off">
    // Chart.js configuration
    const chartColors = {
        primary: 'rgba(59, 130, 246, 0.6)',
        primaryBorder: 'rgba(59, 130, 246, 1)',
        warning: 'rgba(251, 191, 36, 0.6)',
        warningBorder: 'rgba(251, 191, 36, 1)',
        danger: 'rgba(239, 68, 68, 0.6)',
        dangerBorder: 'rgba(239, 68, 68, 1)',
        success: 'rgba(34, 197, 94, 0.6)',
        successBorder: 'rgba(34, 197, 94, 1)',
    };

    const defaultChartOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: { color: 'rgba(255,255,255,0.7)' }
            }
        },
        scales: {
            x: {
                ticks: { color: 'rgba(255,255,255,0.5)' },
                grid: { color: 'rgba(255,255,255,0.1)' }
            },
            y: {
                ticks: { color: 'rgba(255,255,255,0.5)' },
                grid: { color: 'rgba(255,255,255,0.1)' }
            }
        }
    };

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize charts
        initCharts();

        // Map initialization with MapLibre GL JS
        const map = new maplibregl.Map({
            container: 'map',
            style: 'https://lfmaps.fr/styles/osm-bright.json',
            center: [0, 20],
            zoom: 2,
            attributionControl: true,
            attributionCustom: '<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> / <a href="https://lfmaps.fr">LFMaps</a>'
        });

        map.addControl(new maplibregl.NavigationControl());

        const markers = {};

        function addMarker(data) {
            if (data.latitude && data.longitude) {
                const markerKey = data.latitude + ',' + data.longitude;
                const popupContent = '<b>' + (data.city || 'Unknown City') + ', ' + (data.country || 'Unknown Country') + '</b><br>' + data.ip + ' (' + data.reason + ')';
                
                if (markers[markerKey]) {
                    // Update existing marker popup
                    const existingContent = markers[markerKey].getPopup().getElement().innerHTML;
                    markers[markerKey].getPopup().setHTML(existingContent + '<br>' + data.ip + ' (' + data.reason + ')');
                } else {
                    // Create new marker with popup
                    const el = document.createElement('div');
                    el.style.width = '12px';
                    el.style.height = '12px';
                    el.style.borderRadius = '50%';
                    el.style.backgroundColor = '#ef4444';
                    el.style.border = '2px solid #fca5a5';
                    
                    const popup = new maplibregl.Popup({ offset: 15 })
                        .setHTML(popupContent);
                    
                    const marker = new maplibregl.Marker({ element: el })
                        .setLngLat([data.longitude, data.latitude])
                        .setPopup(popup)
                        .addTo(map);
                    
                    markers[markerKey] = marker;
                }
            }
        }

        // Add initial markers
        const initialThreats = JSON.parse(document.getElementById('initial-threats').textContent);
        initialThreats.forEach(addMarker);

        const tableBody = document.querySelector('#threats-table tbody');
        const threatsCount = document.querySelector('.stats.bg-warning .stat-value');
        
        let lastId = 0;
        const firstRow = tableBody.querySelector('tr');
        if (firstRow) {
            lastId = parseInt(firstRow.dataset.id) || 0;
        }

        const evtSource = new EventSource('/sse-threats?lastId=' + lastId);
        
        evtSource.onmessage = function(event) {
            const data = JSON.parse(event.data);
            
            // Add marker to map
            addMarker(data);

            // Check if already in table
            if (document.querySelector('tr[data-id="' + data.id + '"]')) return;

            // Create new row
            const row = document.createElement('tr');
            row.dataset.id = data.id;
            row.classList.add('animate-pulse', 'bg-warning', 'bg-opacity-10');
            
            const countryBadge = data.country && data.country !== 'Unknown' 
                ? '<span class="badge badge-ghost">' + data.country + '</span>' 
                : '<span class="opacity-50">Unknown</span>';
            
            const countryBanForm = data.country && data.country !== 'Unknown'
                ? '<form method="POST">' +
                        '<input type="hidden" name="action" value="add_ban">' +
                        '<input type="hidden" name="target_country" value="' + data.country + '">' +
                        '<input type="hidden" name="type" value="country">' +
                        '<button type="submit" class="btn btn-xs btn-outline btn-error">Ban Country</button>' +
                    '</form>'
                : '';

            row.innerHTML = ' \
                <td style="display:none">' + data.id + '</td> \
                <td> \
                    <a href="/?page=ip-details&ip=' + data.ip + '" class="hover:underline"> \
                        <span class="font-mono">' + data.ip + '</span> \
                    </a> \
                </td> \
                <td>' + countryBadge + '</td> \
                <td>' + data.reason + '</td> \
                <td><span class="text-xs">' + data.detected_at + '</span></td> \
                <td> \
                    <div class="flex gap-2"> \
                        <a href="/?page=ip-details&ip=' + data.ip + '" class="btn btn-xs btn-ghost"> \
                            <i class="bi bi-info-circle"></i> Details \
                        </a> \
                        <form method="POST"> \
                            <input type="hidden" name="action" value="add_ban"> \
                            <input type="hidden" name="target" value="' + data.ip + '"> \
                            <input type="hidden" name="type" value="ip"> \
                            <button type="submit" class="btn btn-xs btn-error">Ban IP</button> \
                        </form> \
                        ' + countryBanForm + ' \
                    </div> \
                </td>';
            
            tableBody.insertBefore(row, tableBody.firstChild);
            
            // Update count
            if (threatsCount) {
                threatsCount.textContent = parseInt(threatsCount.textContent) + 1;
            }
            
            // Remove highlight after 5 seconds
            setTimeout(() => {
                row.classList.remove('animate-pulse', 'bg-warning', 'bg-opacity-10');
            }, 5000);
            
            // Keep only last 50 rows
            while (tableBody.rows.length > 50) {
                tableBody.deleteRow(tableBody.rows.length - 1);
            }
        };

        evtSource.onerror = function(err) {
            console.error("EventSource failed:", err);
        };
    });

    // Chart initialization functions
    let threatsTimeChart = null;

    function initCharts() {
        loadThreatsByHour();
        loadTopCountries();
        loadAttackTypes();
        loadBanTimeline();

        // Period button handlers
        document.querySelectorAll('.chart-period-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.chart-period-btn').forEach(b => b.classList.remove('btn-active'));
                this.classList.add('btn-active');
                const period = this.dataset.period;
                if (period === 'hour') loadThreatsByHour();
                else if (period === 'day') loadThreatsByDay();
                else if (period === 'week') loadThreatsByWeek();
            });
        });
    }

    function loadThreatsByHour() {
        fetch('/api/stats/threats-hour')
            .then(r => r.json())
            .then(data => {
                renderThreatsTimeChart(data, 'hour');
            })
            .catch(err => console.error('Failed to load threats by hour:', err));
    }

    function loadThreatsByDay() {
        fetch('/api/stats/threats-day')
            .then(r => r.json())
            .then(data => {
                renderThreatsTimeChart(data, 'day');
            })
            .catch(err => console.error('Failed to load threats by day:', err));
    }

    function loadThreatsByWeek() {
        fetch('/api/stats/threats-week')
            .then(r => r.json())
            .then(data => {
                renderThreatsTimeChart(data, 'week');
            })
            .catch(err => console.error('Failed to load threats by week:', err));
    }

    function renderThreatsTimeChart(data, period) {
        const ctx = document.getElementById('threatsTimeChart').getContext('2d');
        const labels = data.map(d => period === 'hour' ? d.hour : period === 'day' ? d.day : d.week);
        const counts = data.map(d => d.count);

        if (threatsTimeChart) {
            threatsTimeChart.destroy();
        }

        threatsTimeChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Threats',
                    data: counts,
                    borderColor: chartColors.primaryBorder,
                    backgroundColor: chartColors.primary,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                ...defaultChartOptions,
                scales: {
                    ...defaultChartOptions.scales,
                    y: {
                        ...defaultChartOptions.scales.y,
                        beginAtZero: true
                    }
                }
            }
        });
    }

    function loadTopCountries() {
        fetch('/api/stats/countries?limit=10')
            .then(r => r.json())
            .then(data => {
                const ctx = document.getElementById('topCountriesChart').getContext('2d');
                const labels = data.map(d => d.country);
                const counts = data.map(d => d.count);
                const colors = [
                    chartColors.primary, chartColors.warning, chartColors.danger,
                    chartColors.success, 'rgba(168, 85, 247, 0.6)', 'rgba(236, 72, 153, 0.6)',
                    'rgba(20, 184, 166, 0.6)', 'rgba(249, 115, 22, 0.6)', 'rgba(99, 102, 241, 0.6)',
                    'rgba(132, 204, 22, 0.6)'
                ];
                const borderColors = colors.map(c => c.replace('0.6', '1'));

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Threats',
                            data: counts,
                            backgroundColor: colors.slice(0, labels.length),
                            borderColor: borderColors.slice(0, labels.length),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        ...defaultChartOptions,
                        indexAxis: 'y',
                        plugins: {
                            ...defaultChartOptions.plugins,
                            legend: { display: false }
                        }
                    }
                });
            })
            .catch(err => console.error('Failed to load top countries:', err));
    }

    function loadAttackTypes() {
        fetch('/api/stats/attack-types')
            .then(r => r.json())
            .then(data => {
                const ctx = document.getElementById('attackTypesChart').getContext('2d');
                const labels = data.map(d => d.reason);
                const counts = data.map(d => d.count);
                const colors = [
                    chartColors.danger, chartColors.warning, chartColors.primary,
                    chartColors.success, 'rgba(168, 85, 247, 0.6)', 'rgba(236, 72, 153, 0.6)',
                    'rgba(20, 184, 166, 0.6)', 'rgba(249, 115, 22, 0.6)', 'rgba(99, 102, 241, 0.6)',
                    'rgba(132, 204, 22, 0.6)'
                ];
                const borderColors = colors.map(c => c.replace('0.6', '1'));

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: counts,
                            backgroundColor: colors.slice(0, labels.length),
                            borderColor: borderColors.slice(0, labels.length),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { color: 'rgba(255,255,255,0.7)', boxWidth: 12, padding: 8 }
                            }
                        }
                    }
                });
            })
            .catch(err => console.error('Failed to load attack types:', err));
    }

    function loadBanTimeline() {
        fetch('/api/stats/ban-timeline')
            .then(r => r.json())
            .then(data => {
                const ctx = document.getElementById('banTimelineChart').getContext('2d');
                const labels = data.map(d => d.hour);
                const counts = data.map(d => d.count);

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Bans Expiring',
                            data: counts,
                            backgroundColor: chartColors.warning,
                            borderColor: chartColors.warningBorder,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        ...defaultChartOptions,
                        plugins: {
                            ...defaultChartOptions.plugins,
                            legend: { display: false }
                        },
                        scales: {
                            ...defaultChartOptions.scales,
                            y: {
                                ...defaultChartOptions.scales.y,
                                beginAtZero: true
                            }
                        }
                    }
                });
            })
            .catch(err => console.error('Failed to load ban timeline:', err));
    }
</script>
{/block}
