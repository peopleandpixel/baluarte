{layout 'layout.latte'}

{block title}{_'dashboard.title'}{/block}

{block content}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stats shadow bg-primary text-primary-content">
        <div class="stat">
            <div class="stat-title text-primary-content opacity-70">{_'dashboard.stats.active_bans'}</div>
            <div class="stat-value">{$activeBansCount}</div>
            <div class="stat-figure text-primary-content">
                <i class="bi bi-shield-slash text-3xl"></i>
            </div>
        </div>
    </div>
    
    <div class="stats shadow bg-warning text-warning-content">
        <div class="stat">
            <div class="stat-title text-warning-content opacity-70">{_'dashboard.stats.threats_detected'}</div>
            <div class="stat-value">{$detectedIpsCount}</div>
            <div class="stat-figure text-warning-content">
                <i class="bi bi-exclamation-triangle text-3xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="card bg-base-200 shadow-xl mb-8">
    <div class="card-body">
        <h2 class="card-title mb-4">{_'dashboard.threat_distribution'}</h2>
        <div id="map" style="height: 400px; width: 100%; border-radius: 1rem;"></div>
    </div>
</div>

<script type="application/json" id="initial-threats">
    {$detectedIps|noescape}
</script>

<div class="card bg-base-200 shadow-xl">
    <div class="card-body">
        <div class="flex justify-between items-center mb-4">
            <h2 class="card-title">{_'dashboard.recent_threats'}</h2>
            <a href="/blocked-ips" target="_blank" class="btn btn-sm btn-outline">{_'dashboard.view_blocklist'}</a>
        </div>
        
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full" id="threats-table">
                <thead>
                    <tr>
                        <th style="display:none">ID</th>
                        <th>{_'dashboard.table.ip'}</th>
                        <th>{_'dashboard.table.country'}</th>
                        <th>{_'dashboard.table.reason'}</th>
                        <th>{_'dashboard.table.detected_at'}</th>
                        <th>{_'dashboard.table.actions'}</th>
                    </tr>
                </thead>
                <tbody>
                    {foreach $detectedIps as $threatItem}
                    <tr data-id="{$threatItem['id']}">
                        <td style="display:none">{$threatItem['id']}</td>
                        <td>
                            <a href="/?page=ip-details&ip={$threatItem['ip']}" class="hover:underline">
                                <span class="font-mono">{$threatItem['ip']}</span>
                            </a>
                        </td>
                        <td>
                            {if isset($threatItem['country']) && $threatItem['country'] !== 'Unknown'}
                                <span class="badge badge-ghost">{$threatItem['country']}</span>
                            {else}
                                <span class="opacity-50">{_'dashboard.unknown'}</span>
                            {/if}
                        </td>
                        <td>{$threatItem['reason']}</td>
                        <td><span class="text-xs">{$threatItem['detected_at']}</span></td>
                        <td>
                            <div class="flex gap-2">
                                <a href="/?page=ip-details&ip={$threatItem['ip']}" class="btn btn-xs btn-ghost">
                                    <i class="bi bi-info-circle"></i> {_'dashboard.actions.details'}
                                </a>
                                <form method="POST">
                                    <input type="hidden" name="action" value="add_ban">
                                    <input type="hidden" name="target" value="{$threatItem['ip']}">
                                    <input type="hidden" name="type" value="ip">
                                    <button type="submit" class="btn btn-xs btn-error">{_'dashboard.actions.ban_ip'}</button>
                                </form>
                                {if isset($threatItem['country']) && $threatItem['country'] !== 'Unknown'}
                                <form method="POST">
                                    <input type="hidden" name="action" value="add_ban">
                                    <input type="hidden" name="target_country" value="{$threatItem['country']}">
                                    <input type="hidden" name="type" value="country">
                                    <button type="submit" class="btn btn-xs btn-outline btn-error">{_'dashboard.actions.ban_country'}</button>
                                </form>
                                {/if}
                            </div>
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script n:syntax="off">
    document.addEventListener('DOMContentLoaded', function() {
        // Map initialization
        const map = L.map('map').setView([20, 0], 2);
        L.tileLayer('https://{1}.tile.openstreetmap.org/{2}/{3}/{4}.png'.replace('{1}','s').replace('{2}','z').replace('{3}','x').replace('{4}','y'), {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const markers = {};

        function addMarker(data) {
            if (data.latitude && data.longitude) {
                const markerKey = data.latitude + ',' + data.longitude;
                if (markers[markerKey]) {
                    markers[markerKey].setPopupContent(markers[markerKey].getPopup().getContent() + '<br>' + data.ip + ' (' + data.reason + ')');
                } else {
                    markers[markerKey] = L.marker([data.latitude, data.longitude])
                        .addTo(map)
                        .bindPopup('<b>' + (data.city || 'Unknown City') + ', ' + (data.country || 'Unknown Country') + '</b><br>' + data.ip + ' (' + data.reason + ')');
                }
            }
        }

        // Add initial markers
        const initialThreats = JSON.parse(document.getElementById('initial-threats').textContent);
        initialThreats.forEach(addMarker);

        const tableBody = document.querySelector('#threats-table tbody');
        const threatsCount = document.querySelector('.stats.bg-warning .stat-value');
        
        let lastId = 0;
        const firstRow = tableBody.querySelector('tr');
        if (firstRow) {
            lastId = parseInt(firstRow.dataset.id) || 0;
        }

        const evtSource = new EventSource('/sse-threats?lastId=' + lastId);
        
        evtSource.onmessage = function(event) {
            const data = JSON.parse(event.data);
            
            // Add marker to map
            addMarker(data);

            // Check if already in table
            if (document.querySelector('tr[data-id="' + data.id + '"]')) return;

            // Create new row
            const row = document.createElement('tr');
            row.dataset.id = data.id;
            row.classList.add('animate-pulse', 'bg-warning', 'bg-opacity-10');
            
            const countryBadge = data.country && data.country !== 'Unknown' 
                ? '<span class="badge badge-ghost">' + data.country + '</span>' 
                : '<span class="opacity-50">Unknown</span>';
            
            const countryBanForm = data.country && data.country !== 'Unknown'
                ? '<form method="POST">' +
                        '<input type="hidden" name="action" value="add_ban">' +
                        '<input type="hidden" name="target_country" value="' + data.country + '">' +
                        '<input type="hidden" name="type" value="country">' +
                        '<button type="submit" class="btn btn-xs btn-outline btn-error">Ban Country</button>' +
                    '</form>'
                : '';

            row.innerHTML = ' \
                <td style="display:none">' + data.id + '</td> \
                <td> \
                    <a href="/?page=ip-details&ip=' + data.ip + '" class="hover:underline"> \
                        <span class="font-mono">' + data.ip + '</span> \
                    </a> \
                </td> \
                <td>' + countryBadge + '</td> \
                <td>' + data.reason + '</td> \
                <td><span class="text-xs">' + data.detected_at + '</span></td> \
                <td> \
                    <div class="flex gap-2"> \
                        <a href="/?page=ip-details&ip=' + data.ip + '" class="btn btn-xs btn-ghost"> \
                            <i class="bi bi-info-circle"></i> Details \
                        </a> \
                        <form method="POST"> \
                            <input type="hidden" name="action" value="add_ban"> \
                            <input type="hidden" name="target" value="' + data.ip + '"> \
                            <input type="hidden" name="type" value="ip"> \
                            <button type="submit" class="btn btn-xs btn-error">Ban IP</button> \
                        </form> \
                        ' + countryBanForm + ' \
                    </div> \
                </td>';
            
            tableBody.insertBefore(row, tableBody.firstChild);
            
            // Update count
            if (threatsCount) {
                threatsCount.textContent = parseInt(threatsCount.textContent) + 1;
            }
            
            // Remove highlight after 5 seconds
            setTimeout(() => {
                row.classList.remove('animate-pulse', 'bg-warning', 'bg-opacity-10');
            }, 5000);
            
            // Keep only last 50 rows
            while (tableBody.rows.length > 50) {
                tableBody.deleteRow(tableBody.rows.length - 1);
            }
        };

        evtSource.onerror = function(err) {
            console.error("EventSource failed:", err);
        };
    });
</script>
{/block}
