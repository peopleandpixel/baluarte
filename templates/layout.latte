<!DOCTYPE html>
<html lang="{$locale ?? 'en'}" data-theme="{$config['gui']['theme'] ?? 'baluarte'}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ifset title}{include title} - {/ifset}{_'app.name'} Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dark: '#08121c',
                    }
                }
            },
            daisyui: {
                themes: [
                    {
                        baluarte: {
                            "primary": "#3b82f6",
                            "secondary": "#64748b",
                            "accent": "#1fb2a6",
                            "neutral": "#191d24",
                            "base-100": "#08121c",
                            "info": "#3abff8",
                            "success": "#36d399",
                            "warning": "#fbbd23",
                            "error": "#f87272",
                        },
                    },
                    {
                        "baluarte_light": {
                            "primary": "#3b82f6",
                            "secondary": "#64748b",
                            "accent": "#1fb2a6",
                            "neutral": "#f3f4f6",
                            "base-100": "#ffffff",
                            "info": "#3abff8",
                            "success": "#36d399",
                            "warning": "#fbbd23",
                            "error": "#f87272",
                        },
                    },
                ],
            },
        }
    </script>
    <style>
        [data-theme="baluarte"] body { background-color: #08121c; color: #e2e8f0; }
        [data-theme="baluarte_light"] body { background-color: #ffffff; color: #1f2937; }
    </style>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>
<body class="min-h-screen bg-base-100">
    <div class="drawer lg:drawer-open">
        <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content flex flex-col">
            <!-- Navbar -->
            <div class="w-full navbar bg-base-200 lg:hidden">
                <div class="flex-none">
                    <label for="my-drawer-2" class="btn btn-square btn-ghost">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 px-2 mx-2">
                    <img src="assets/img/logo.jpg" alt="{_'app.name'}" class="h-8 w-8 mr-2 rounded">
                    {_'app.name'}
                </div>
            </div>
            
            <!-- Page content here -->
            <main class="p-6">
                {include content}
            </main>
        </div> 
        <div class="drawer-side">
            <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"></label> 
            <ul class="menu p-4 w-80 min-h-full bg-base-200 text-base-content">
                <!-- Sidebar content here -->
                <li class="mb-4">
                    <div class="flex items-center gap-2 text-xl font-bold">
                        <img src="assets/img/logo.jpg" alt="{_'app.name'}" class="h-10 w-10 rounded">
                        <span>{_'app.name'}</span>
                    </div>
                </li>
                <li><a href="/?page=dashboard" class="{if $page === 'dashboard'}active{/if}"><i class="bi bi-speedometer2"></i> {_'nav.dashboard'}</a></li>
                <li><a href="/?page=bans" class="{if $page === 'bans'}active{/if}"><i class="bi bi-shield-slash"></i> {_'nav.bans'}</a></li>
                <li><a href="/?page=settings" class="{if $page === 'settings'}active{/if}"><i class="bi bi-gear"></i> {_'nav.settings'}</a></li>
                <li><a href="/?page=logout" class="text-error"><i class="bi bi-box-arrow-right"></i> {_'nav.logout'}</a></li>
                <li class="mt-auto opacity-50 text-xs flex items-center justify-between">
                    <span>{_'app.version'}</span>
                    <form method="get" class="ml-2">
                        <label class="label text-xs mr-2">{_'lang.select'}</label>
                        <select name="lang" class="select select-bordered select-xs" onchange="this.form.submit()">
                            {foreach $availableLocales as $l}
                                <option value="{$l}" {if $l === ($locale ?? 'en')}selected{/if}>{$l}</option>
                            {/foreach}
                        </select>
                    </form>
                </li>
            </ul>
        </div>
    </div>
    {ifset scripts}{include scripts}{/ifset}
</body>
</html>
